spriteTypes = {
	spriteType = {
		name = "GFX_SRA_T4_ship_Part"
		texturefile = "gfx/interface/icons/ship_parts/SRA_T4_ship_Part.dds"
		animation = {
			animationmaskfile = "gfx/interface/icons/ship_parts/SRA_T4_ship_Part.dds"			
			animationtexturefile = "gfx/interface/icons/relics/shine_overlay.dds" 	# <- the animated file
			animationrotation = 90		# -90 clockwise 90 counterclockwise(by default)
			animationlooping = yes			# yes or no ;)
			animationtime = 1.6				# in seconds
			animationdelay = 3			# in seconds
			animationblendmode = "add"       #add, multiply, overlay
			animationtype = "pulsing"      #scrolling, rotating, pulsing
			animationrotationoffset = { x = 0.0 y = 0.0 }
			animationtexturescale = { x = 1.0 y = 1.0 }
		}
	}
