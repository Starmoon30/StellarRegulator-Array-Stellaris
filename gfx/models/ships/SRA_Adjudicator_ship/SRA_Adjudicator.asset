animation = { name = "SRA_Adjudicator_idle_animation" file = "SRA_Adjudicator_idle.anim" }
animation = { name = "SRA_Adjudicator_opening_animation" file = "SRA_Adjudicator_opening.anim" }
animation = { name = "SRA_Adjudicator_opened_animation" file = "SRA_Adjudicator_attack.anim" }
animation = { name = "SRA_Adjudicator_closing_animation" file = "SRA_Adjudicator_closing.anim" }

entity = {
	name = "SRA_Adjudicator_entity"
	pdxmesh = "SRA_ancient_large_ship_frame_mesh"
	
	scale = 4
	default_state = "idle"
	state = { name = "idle"	 animation = "idle" animation_blend_time = 0.25
		start_event = { trigger_once = yes sound = { soundeffect = "SRA_ancient_ship_massive_idle_01" } }
		start_event = { trigger_once = yes sound = { soundeffect = "SRA_ancient_ship_massive_idle_02" } }
	}
	state = { name = "moving"	animation = "idle" animation_blend_time = 0.25
		start_event = { trigger_once = yes sound = { soundeffect = "SRA_ancient_ship_massive_idle_01" } }
		start_event = { trigger_once = yes sound = { soundeffect = "SRA_ancient_ship_massive_idle_02" } }
		event = { trigger_once = yes sound = { soundeffect = "moving_out_titan" stop_on_state_change = yes } }
	}
	state = { name = "death" animation = "death1" animation_blend_time = 0.0 chance = 1 looping = no
		event = { time = 4.6 node = "root" particle = "SRA_large_explosion_blue" keep_particle = yes sound = { soundeffect = "station_explosion_energy" } }
	}
	state = { name = "death" animation = "death2" animation_blend_time = 0.0 chance = 1 looping = no
		event = { time = 4.6 node = "root" particle = "SRA_large_explosion_blue" keep_particle = yes sound = { soundeffect = "station_explosion_energy" } }
	}
	state = { name = "death" animation = "death3" animation_blend_time = 0.0 chance = 1 looping = no
		event = { time = 4.6 node = "root" particle = "SRA_large_explosion_blue" keep_particle = yes sound = { soundeffect = "station_explosion_energy" } }
	}
	
	game_data = {
		size = 64
		emissive_recolor_crunch = 0.0
	}
}
entity = {
	name = "SRA_Adjudicator_hull_entity"
	pdxmesh = "SRA_Adjudicator_mesh"
	scale = 1

	attach = { crystal_S_Jnt = "SRA_Adjudicator_crystal_S_entity" }
	attach = { crystal_A_Jnt = "SRA_Adjudicator_crystal_A_entity" }
	attach = { crystal_B_Jnt = "SRA_Adjudicator_crystal_B_entity" }
	attach = { crystal_C_Jnt = "SRA_Adjudicator_crystal_C_entity" }
	attach = { crystal_D_Jnt = "SRA_Adjudicator_crystal_D_entity" }
	attach = { ifw_A_Jnt = "SRA_Adjudicator_ifw_A_entity" }
	attach = { ifw_B_Jnt = "SRA_Adjudicator_ifw_B_entity" }
	attach = { ifw_C_Jnt = "SRA_Adjudicator_ifw_C_entity" }
	attach = { ifw_D_Jnt = "SRA_Adjudicator_ifw_D_entity" }


	default_state = "idle"
	state = { name = "idle"		animation = "idle" animation_speed = 0.5 animation_blend_time = 0.2 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 1
		}
	}
	state = { name = "idle"		animation = "closing" animation_speed = 0.5 animation_blend_time = 0 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 0
		}
	}
	state = { name = "combat_idle"		animation = "opening" animation_blend_time = 2 looping = no next_state = "combat_idle"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 0
		}
	}
	state = { name = "combat_idle"		animation = "opened" animation_speed = 0.1 animation_blend_time = 0.2 looping = yes next_state = "combat_idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 1
		}
	}
	state = { name = "combat_moving"		animation = "opening" animation_blend_time = 0 looping = no next_state = "combat_moving"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 0
		}
	}
	state = { name = "combat_moving"		animation = "opened" animation_speed = 0.1 animation_blend_time = 0.2 looping = yes next_state = "combat_moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 1
		}
	}
	state = { name = "moving"		animation = "closing" animation_blend_time = 0 looping = no next_state = "moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 0
		}
	}
	state = { name = "moving"		animation = "idle" animation_speed = 0.5 animation_blend_time = 0.2 looping = no next_state = "moving"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 1
		}
	}
	game_data = {
		emissive_recolor_crunch = 0.0
	}		# 自发光不随旗帜改变。
}


