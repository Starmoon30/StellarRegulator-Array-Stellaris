entity = {
	name = "SRA_zeta_core_sphere_station_entity"
	pdxmesh = "SRA_zeta_core_sphere_type2_mesh"
	
	scale = 1.0
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" }
}

entity = {
	name = "SRA_GZ_Platform_entity"
	pdxmesh = "SRA_zeta_military_station_small_frame_mesh"
	
	scale = 1.0
	default_state = "idle"
	state = { name = "idle"	 animation = "idle" animation_blend_time = 0.25
		start_event = { trigger_once = yes sound = { soundeffect = "SRA_ancient_station_small_idle" } }
	}
	state = { name = "moving"	animation = "idle" animation_blend_time = 0.25
		start_event = { trigger_once = yes sound = { soundeffect = "SRA_ancient_station_small_idle" } }
	}
	state = { name = "death" animation = "death1" animation_blend_time = 0.0 chance = 1 looping = no
		event = { time = 4.6 node = "root" particle = "SRA_zeta_military_station_small_explosion_blue" keep_particle = yes sound = { soundeffect = "station_explosion_energy" } }
	}
	state = { name = "death" animation = "death2" animation_blend_time = 0.0 chance = 1 looping = no
		event = { time = 4.6 node = "root" particle = "SRA_zeta_military_station_small_explosion_blue" keep_particle = yes sound = { soundeffect = "station_explosion_energy" } }
	}
	state = { name = "death" animation = "death3" animation_blend_time = 0.0 chance = 1 looping = no
		event = { time = 4.6 node = "root" particle = "SRA_zeta_military_station_small_explosion_blue" keep_particle = yes sound = { soundeffect = "station_explosion_energy" } }
	}
	
	game_data = {
		emissive_recolor_crunch = 0.0
		size = 50
	}
}
entity = {
	name = "SRA_GZ_Platform_hull_small_entity"
	pdxmesh = "SRA_zeta_military_station_small_mesh"
	
	scale = 2
	
	locator = { name = "core_beam_locator" 	position = { 0 0 0 } rotation = { 0 90 0 } }
